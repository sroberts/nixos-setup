# Per-host hardware-configuration.nix files (hosts/<name>/) are committed —
# flakes only see git-tracked files, and the LUKS UUIDs they carry are
# identifiers, not secrets. See hosts/README.md.

# nix build output symlinks
result
result-*

# direnv / lorri local state
.direnv/
.envrc.local

# editor scratch
*.swp
*.swo
*~
.DS_Store

# AI coding-agent local state. Machine-local, not config: settings.local.json
# holds per-machine tool permissions, and .crush/ is a SQLite session DB +
# logs. These were previously only ignored via the repo owner's *global*
# ~/.config/git/ignore (and crush's self-written .crush/.gitignore), so a
# fresh clone on a new machine — the exact workflow this repo exists for —
# would show them as untracked.
.claude/settings.local.json
.crush/
